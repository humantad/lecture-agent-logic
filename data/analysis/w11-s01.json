t_concept_id": "C20", "relation_type": "grounding", "direction": "unidirectional", "provenance": "explicit", "strength": 0.6, "evidence": [{"chunk_id": "chunk_000", "start_char": 1789, "end_char": 1812, "text": "아리스토텔레스 해석 : 주어의 존재를 가정"}], "inference_basis": null, "lexical_marker": "가정", "excluded_possibilities": [], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "R17", "source_concept_id": "C22", "target_concept_id": "C20", "relation_type": "grounding", "direction": "unidirectional", "provenance": "explicit", "strength": 0.6, "evidence": [{"chunk_id": "chunk_000", "start_char": 1813, "end_char": 1834, "text": "불(Boole) 해석 : 가정하지 않음"}], "inference_basis": null, "lexical_marker": "가정하지 않음", "excluded_possibilities": [], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "R18", "source_concept_id": "C20", "target_concept_id": "C23", "relation_type": "causal", "direction": "unidirectional", "provenance": "explicit", "strength": 0.6, "evidence": [{"chunk_id": "chunk_000", "start_char": 0, "end_char": 120, "text": "정언 명제\n1\n정언 논리의 형식\n단순 명제를 구성하는 단어 단위의 구성요소들의 관계에 바탕을 둔 논리 체계\n정언 명제(categorical proposition)로 이루어진 논리 체계\n정언 명제: 주어와 술어의 포함"}], "inference_basis": null, "lexical_marker": "바로 이 문제의", "excluded_possibilities": [], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "R19", "source_concept_id": "C25", "target_concept_id": "C24", "relation_type": "constitutive", "direction": "unidirectional", "provenance": "explicit", "strength": 0.7, "evidence": [{"chunk_id": "chunk_000", "start_char": 1945, "end_char": 1973, "text": "환위(conversion) — 주어와 술어를 맞바꿈"}], "inference_basis": null, "lexical_marker": "구성", "excluded_possibilities": [], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "R20", "source_concept_id": "C26", "target_concept_id": "C24", "relation_type": "constitutive", "direction": "unidirectional", "provenance": "explicit", "strength": 0.7, "evidence": [{"chunk_id": "chunk_000", "start_char": 2035, "end_char": 2067, "text": "환질(obversion) — 질을 바꾸고 술어를 여집합으로"}], "inference_basis": null, "lexical_marker": "구성", "excluded_possibilities": [], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "R21", "source_concept_id": "C27", "target_concept_id": "C24", "relation_type": "constitutive", "direction": "unidirectional", "provenance": "explicit", "strength": 0.7, "evidence": [{"chunk_id": "chunk_000", "start_char": 2112, "end_char": 2150, "text": "이환(contraposition) — 주술을 바꾸며 둘 다 여집합으로"}], "inference_basis": null, "lexical_marker": "구성", "excluded_possibilities": [], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "N1", "source_concept_id": "C2", "target_concept_id": "", "relation_type": "negative_positing", "direction": "exclusion", "provenance": "inferred", "strength": 0.625, "evidence": [], "inference_basis": "logical_alternative: 정언 논리는 주어-술어 단일 관계로 명제를 환원하지만, '아리스토텔레스는 플라톤의 제자이다'와 같은 관계적 진술은 이 틀로 자연스럽게 표현되지 않는다. 텍스트는 이러한 다항 관계 명제의 가능성을 전혀 언급하지 않음으로써 암묵적으로 배제한다.", "lexical_marker": null, "excluded_possibilities": ["관계 명제(이항 이상 관계)를 다루는 관계 논리"], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "N2", "source_concept_id": "C2", "target_concept_id": "", "relation_type": "negative_positing", "direction": "exclusion", "provenance": "inferred", "strength": 0.55, "evidence": [], "inference_basis": "temporal: 텍스트는 전통적 정언 논리 체계만을 서술하며, 저자 당대(현대 논리학 교육 시점)에 이미 확립된 1차 술어논리, 다중 양화사, 변항 바인딩 등 더 강력한 형식 체계를 언급하지 않는다. 이는 정언 논리를 유일하거나 충분한 체계인 것처럼 정립하는 효과를 낳는다.", "lexical_marker": null, "excluded_possibilities": ["프레게·러셀 이후의 현대 술어논리(양화 이론)"], "mediating_concept_id": null, "determinable_target": null, "cosine_similarity": null}, {"id": "N3", "source_concept_id": "C13", "target_concept_id": "", "relation_type": "negative_positing", "direct